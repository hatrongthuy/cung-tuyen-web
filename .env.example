# ==========================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG — copy file này thành ".env.local" khi chạy ở máy cá nhân,
# hoặc khai báo từng dòng trong mục "Environment Variables" của Vercel khi deploy.
# Xem hướng dẫn chi tiết từng bước lấy giá trị trong README.md.
# ==========================================================================

# ---- 1. Google OAuth (đăng nhập bằng Google) ----
# Lấy tại https://console.cloud.google.com/apis/credentials
# Tạo "OAuth client ID" loại "Web application".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- 2. NextAuth (Auth.js) ----
# NEXTAUTH_SECRET: một chuỗi bí mật ngẫu nhiên, dùng để mã hoá phiên đăng nhập.
# Tạo nhanh bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=

# NEXTAUTH_URL: địa chỉ gốc của web app sau khi deploy, ví dụ:
# https://cung-tuyen-nhom-ha-trong-thuy.vercel.app
# Khi chạy ở máy cá nhân (npm run dev) thì để http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ---- 3. Google Sheets — đọc dữ liệu bằng SERVICE ACCOUNT ----
# Tạo Service Account tại https://console.cloud.google.com/iam-admin/serviceaccounts
# rồi bật "Google Sheets API" cho project, tạo key dạng JSON, lấy 2 giá trị dưới đây
# từ file JSON đó ("client_email" và "private_key").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Lưu ý: giữ nguyên các ký tự \n trong private key khi dán vào đây (dán trong 1 dòng,
# có dấu ngoặc kép bao quanh). Xem README.md để biết cách dán đúng trên Vercel.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID của Google Sheet chứa dữ liệu cung tuyến (đã có sẵn, lấy trong đường link sheet:
# https://docs.google.com/spreadsheets/d/<ĐÂY_LÀ_ID>/edit)
# Giá trị thật của hệ thống hiện tại:
GOOGLE_SHEETS_SPREADSHEET_ID=1c-vwUXNL-zBhftZKWLNPsom4noFITSaO8vDP-FZ18dU

# ---- 4. Google Sheets "báo cáo thầu" — spreadsheet RIÊNG, khác với mục 3 ----
# Cùng service account ở mục 3 đọc được sheet này, nhưng phải VÀO SHEET NÀY và Share
# (Chia sẻ) quyền Viewer cho đúng email trong GOOGLE_SERVICE_ACCOUNT_EMAIL ở trên
# (xem README.md mục "Báo cáo thầu" để biết các bước cụ thể).
# ID lấy trong đường link sheet: https://docs.google.com/spreadsheets/d/<ĐÂY_LÀ_ID>/edit
GOOGLE_SHEETS_THAU_SPREADSHEET_ID=12rUumsB65y5wexTASLyh07p81JHnMY2lAjCuYLAESxc

# Tên tab chứa dữ liệu chi tiết — đổi theo tháng (vd "Chi tiết 1.8.2026", "Chi tiết 1.9.2026"...).
# Khi có tab tháng mới: chỉ cần sửa giá trị này rồi Redeploy trên Vercel, KHÔNG cần sửa code.
GOOGLE_SHEETS_THAU_TAB=Chi tiết 1.8.2026

# ---- 4b. Google Sheets "KPI - Chỉ tiêu tháng" — spreadsheet RIÊNG (KPI + Doanh số) ----
# Trang KPI và trang Doanh số đọc dữ liệu từ file này. Cùng service account ở mục 3 đọc
# được, nhưng BẮT BUỘC phải mở file này và Share (Chia sẻ) quyền Viewer cho email trong
# GOOGLE_SERVICE_ACCOUNT_EMAIL — nếu quên bước này, trang KPI và Doanh số sẽ TRỐNG.
# Biến dưới đây có thể để trống (app dùng ID mặc định đã cấu hình sẵn trong code);
# chỉ đặt khi muốn trỏ sang file KPI khác.
GOOGLE_SHEETS_KPI_SPREADSHEET_ID=1Yd2bHhWEbEKh68PFuL7GqPGD1pAW14SxkGZNp5lELD4

# ---- 4c. Google Sheets dữ liệu Sale "sạch" — nguồn DOANH SỐ THỰC HIỆN ----
# File "PS_TayBac_DuLieuSach" chứa từng giao dịch bán hàng (Mã nhân viên, Ngày, Doanh thu...).
# Web đọc tab "Sale sạch" và cộng dồn theo nhân viên/kỳ để ra doanh số THỰC HIỆN.
# File này đang để "Bất kỳ ai có link đều xem" nên service account đọc được ngay.
# Để trống sẽ dùng ID + tên tab mặc định trong code.
GOOGLE_SHEETS_SALES_SPREADSHEET_ID=19CNg5Q38a7tAyNR8NSY6-E5U1Q1kqdhsblftGuGDsdU
GOOGLE_SHEETS_SALES_TAB=Sale sạch

# ---- 6. Gemini (nút "Phân tích AI" trong Báo cáo tuần) ----
# Tạo API key miễn phí tại https://aistudio.google.com/apikey rồi dán vào đây / khai báo trên Vercel.
# Nếu KHÔNG đặt, nút Phân tích AI sẽ báo "chưa cấu hình" (các phần khác vẫn chạy bình thường).
GEMINI_API_KEY=
# Model dùng (tùy chọn) — mặc định gemini-3.6-flash. Có thể đổi sang model khác nếu muốn.
GEMINI_MODEL=gemini-3.6-flash

# ---- 5. Webhook n8n dùng để nhân viên xác nhận/phản hồi gợi ý ----
# Đây là URL production thật của node "Nhận xác nhận gợi ý" trong workflow n8n
# "Lập cung tuyến tuần — Nhóm Hà Trọng Thủy" (đã lấy sẵn, chỉ cần copy nguyên văn):
N8N_CONFIRM_WEBHOOK_URL=https://n8n.cpc1hn.com.vn/webhook/b9af5578-41a8-4d25-a2e5-ad749671f9e8/xac-nhan-goi-y
