# ==========================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG — copy file này thành ".env.local" khi chạy ở máy cá nhân,
# hoặc khai báo từng dòng trong mục "Environment Variables" của Vercel khi deploy.
# Xem hướng dẫn chi tiết từng bước lấy giá trị trong README.md.
# ==========================================================================

# ---- 1. Google OAuth (đăng nhập bằng Google) ----
# Lấy tại https://console.cloud.google.com/apis/credentials
# Tạo "OAuth client ID" loại "Web application".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- 2. NextAuth (Auth.js) ----
# NEXTAUTH_SECRET: một chuỗi bí mật ngẫu nhiên, dùng để mã hoá phiên đăng nhập.
# Tạo nhanh bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=

# NEXTAUTH_URL: địa chỉ gốc của web app sau khi deploy, ví dụ:
# https://cung-tuyen-nhom-ha-trong-thuy.vercel.app
# Khi chạy ở máy cá nhân (npm run dev) thì để http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ---- 3. Google Sheets — đọc dữ liệu bằng SERVICE ACCOUNT ----
# Tạo Service Account tại https://console.cloud.google.com/iam-admin/serviceaccounts
# rồi bật "Google Sheets API" cho project, tạo key dạng JSON, lấy 2 giá trị dưới đây
# từ file JSON đó ("client_email" và "private_key").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Lưu ý: giữ nguyên các ký tự \n trong private key khi dán vào đây (dán trong 1 dòng,
# có dấu ngoặc kép bao quanh). Xem README.md để biết cách dán đúng trên Vercel.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID của Google Sheet chứa dữ liệu cung tuyến (đã có sẵn, lấy trong đường link sheet:
# https://docs.google.com/spreadsheets/d/<ĐÂY_LÀ_ID>/edit)
# Giá trị thật của hệ thống hiện tại:
GOOGLE_SHEETS_SPREADSHEET_ID=1c-vwUXNL-zBhftZKWLNPsom4noFITSaO8vDP-FZ18dU

# ---- 4. Webhook n8n dùng để nhân viên xác nhận/phản hồi gợi ý ----
# Đây là URL production thật của node "Nhận xác nhận gợi ý" trong workflow n8n
# "Lập cung tuyến tuần — Nhóm Hà Trọng Thủy" (đã lấy sẵn, chỉ cần copy nguyên văn):
N8N_CONFIRM_WEBHOOK_URL=https://n8n.cpc1hn.com.vn/webhook/b9af5578-41a8-4d25-a2e5-ad749671f9e8/xac-nhan-goi-y
